{
  "name": "front",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:site": "vite --config vite.site.config.ts",
    "dev:app": "vite --config vite.app.config.ts",
    "start": "vite",
    "build": "npm run build:app && npm run build:site",
    "build:site": "vite build --config vite.site.config.ts",
    "build:app": "vite build --config vite.app.config.ts",
    "preview": "vite preview",
    "preview:site": "vite preview --config vite.site.config.ts",
    "preview:app": "vite preview --config vite.app.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^4.1.3",
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.0.0",
    "react-router-dom": "^6.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.0.0",
    "postcss": "^8.0.0",
    "tailwindcss": "^3.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-static-copy": "^2.3.1"
  }
}
